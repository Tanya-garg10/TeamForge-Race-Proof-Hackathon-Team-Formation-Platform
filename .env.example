# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: HTTP + Socket.IO server port (AI Studio requires 3000).
PORT=3000

# JWT_SECRET: Cryptographic secret for signing JWT session tokens (use >= 32 random bytes in production).
JWT_SECRET="replace-with-strong-random-secret"

# CORS_ORIGINS: Comma-separated allowed origins for production CORS.
CORS_ORIGINS="http://localhost:3000"

# SQLITE_DB_PATH: Optional path for persistent SQLite storage.
SQLITE_DB_PATH="./data/teamforge.db"

# POSTGRES_PRISMA_URL: PostgreSQL connection string for standalone Prisma/PostgreSQL deployments.
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/teamforge?schema=public"
